  "_featureProvenance": {
    "source": "storage/pdfs/876872b259b742d2595f311ca28fd4ea8b8176ff5f307afad8deb0cd9655c45f.pdf（トヨタ ヤリス 主要装備一覧表 2026-04版）の3〜5ページ",
