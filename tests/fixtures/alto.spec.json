  "_priceProvenance": {
    "source": "https://www.suzuki.co.jp/car/alto/detail/",
    "readAt": "2026-08-31",
    "readBy": "Claude Opus 5 が Chrome 経由でページを描画させ、グレードのタブを順に開いて読み取った",
    "note": "諸元表PDFに車両本体価格は載っていない。価格はグレードごとのタブ切り替えで表示される。",
    "excludedVariant": "「L アップグレードパッケージ装着車」（2WD 1,379,400円 / 4WD 1,510,300円）は別グレードとして取り込んでいない。メーカーオプション装着車であり、その内容は L の features に option として反映してある。"
  },
  "_specProvenance": {
    "source": "storage/pdfs/caa4a4cf6727a174a3451a49d2014fa1b228534b7b08704dcd838afaf91cfe64.pdf（スズキ アルト 主要諸元 / detail.pdf）2ページ",
    "readAt": "2026-08-31",
    "brackets": "【 】と［ ］はオプションパッケージ装着車の値であって駆動方式ではない。車両重量 700【710】の【710】は「LEDヘッドランプ装着車」の重量、690［700］の［700］は「アップグレードパッケージ装着車」の重量である。トヨタの ［ ］（4WDの値）と同じに扱うと、オプション装着車の重量を4WDの重量として取り込む。素の値を採った。",
    "typeDesignation": "型式は 5AA-HA97S（HYBRID X/S）と 3BA-HA37S（L/A）の2つしかなく、8バリアントを覆う。バリアントごとに一意なのは「機種記号」（ABXB-3 など）で、参考として _modelCode に残した。型式の一意制約は既に外してあり、同定は 名前/パワートレイン/駆動方式 の複合キーで行っている。",
    "driveSystem": "原本の表記は「2WD（前2輪駆動）」「フルタイム4WD」。DRIVE_SYSTEM_ALIASES に追加した。",
    "seating": "乗車定員は4名。これまで取り込んだ3車種（5名）と違う。",
    "cruisingRange": "諸元表に航続可能距離の記載が無いため null。"
  },
  "_featureProvenance": {
    "source": "同じPDFの1ページ（主要装備）",
    "readAt": "2026-08-31",
    "legend": "水色 RGB(136,216,248) が標準装備、黄色が メーカーオプション、白が設定なし。トヨタと同じ色方式だが色そのものは違う。",
    "columns": "装備表は7列。グレードごとに「▲パッケージ装着車」が左、素のグレードが右に並ぶ（A だけは1列）。LEDヘッドランプの行が決め手で、HYBRID S は素だと設定なし、▲LEDヘッドランプ装着車だと標準になる。駆動方式では装備は変わらない。",
    "packageAsOption": "▲装着車の列は、素のグレードに対するメーカーオプションとして option に写した。実際にページ上で「全方位モニター用カメラパッケージ・スズキコネクト対応通信機装着車 ※価格110,000円高」と価格が付いており、オプションであることが裏付けられる。",
    "rowMapping": {
      "collisionMitigationBrake": "デュアルセンサーブレーキサポートⅡ",
      "falseStartSuppression": "誤発進抑制機能",
      "laneDepartureWarning": "車線逸脱警報機能",
      "laneKeepingAssist": "車線逸脱抑制機能",
      "adaptiveCruiseControl": "記載なし。アルトにアダプティブクルーズコントロールの設定が無いため全グレード none",
      "blindSpotMonitor": "記載なし。全グレード none",
      "camera360": "全方位モニター用カメラ［フロント/サイド（左右）/バックカメラ］。HYBRID X と HYBRID S のパッケージ装着車に含まれるため option。L のパッケージはバックアイカメラのみで全方位ではないため none",
      "parkingAssist": "記載なし。「パーキングセンサー（フロント・リヤ）」は全グレード標準だが、これは障害物センサーであって自動駐車ではない。ホンダ フィットと同じ判断で全グレード none",
      "navigation": "記載なし。ナビ本体の設定が無く、パッケージに含まれるのは「対応ナビゲーション接続用USBソケット」まで。全グレード none",
      "etc": "記載なし。全グレード none",
      "backCamera": "HYBRID X / HYBRID S は全方位モニター用カメラパッケージ、L はバックアイカメラ・スズキコネクト対応通信機装着車に含まれるため option。A はどちらの設定も無いため none",
      "powerSeat": "記載なし。全グレード none",
      "seatHeater": "運転席シートヒーター（助手席シートヒーターも全グレード標準）",
      "steeringHeater": "記載なし。全グレード none",
      "autoAircon": "フルオートエアコン［エアフィルター付］。HYBRID S と L は素だとマニュアルエアコンで、パッケージ装着車がフルオートになるため option",
      "ledHeadlight": "LEDヘッドランプ［ハイ/ロービーム、マニュアルレベリング機構付］。HYBRID S と L は素だとマルチリフレクターハロゲンで、パッケージ装着車がLEDになるため option",
      "smartKey": "キーレスプッシュスタートシステム。HYBRID X のみ標準で、他のグレードはパッケージ装着車にも含まれないため none",
      "powerBackDoor": "記載なし。全グレード none",
      "handsFreeBackDoor": "記載なし。全グレード none",
